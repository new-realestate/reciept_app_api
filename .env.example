# Local dev default. In Render, this is populated from the managed Postgres
# instance (postgres:// or postgresql://) and auto-rewritten to use the
# asyncpg driver by app/core/config.py — no manual scheme editing needed.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/receipt_app

# In Render: generate with `python -c "import secrets; print(secrets.token_urlsafe(64))"`
# and set as a real secret env var. Never reuse the local dev value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Real Postmark production values in Render.
POSTMARK_SERVER_TOKEN=d
POSTMARK_FROM_EMAIL=receipts@example.com

# Real Twilio production values in Render.
TWILIO_ACCOUNT_SID=d
TWILIO_AUTH_TOKEN=d
TWILIO_FROM_NUMBER=d

# In Render: set to the public service URL, e.g. https://receipt-app.onrender.com
# (or your custom domain). Used to build links sent in emails/SMS.
APP_BASE_URL=http://localhost:8000

# In Render: must match the mountPath of the persistent disk (see render.yaml),
# e.g. /app/static. Without a persistent disk, generated PDFs/logos/signatures
# are lost on every redeploy/restart.
STORAGE_DIR=./static

# Seed pre-verified users on startup (no email API needed). Idempotent: users
# whose email already exists are skipped. Roles: owner, admin, staff.
# Leave disabled in production unless you set strong passwords.
SEED_DEFAULT_USERS_ENABLED=true
SEED_DEFAULT_USERS=[{"email":"admin@example.com","password":"ChangeMe123!","full_name":"Admin User","business_name":"Demo Business","role":"owner"},{"email":"staff@example.com","password":"ChangeMe123!","full_name":"Staff User","business_name":"Demo Staff Business","role":"staff"}]

# Comma-separated list of browser origins allowed to call this API (CORS).
# In Render: include the deployed frontend portal's URL, e.g.
# https://portal.example.com,http://localhost:5173
CORS_ALLOW_ORIGINS_RAW=http://localhost:5173

# Regex of additional browser origins to allow (CORS), on top of the explicit
# list above. Defaults to the portal's Vercel preview/production URL pattern,
# since those change on every deploy and can't be pinned to one origin. Leave
# unset to use the default, or set to an empty string to disable.
# CORS_ALLOW_ORIGIN_REGEX=^https://recieptappportal(-[a-z0-9]+)?-mmadiba724s-projects\.vercel\.app$
